# ==============================================================================
# Zotero-Chat Environment Configuration
# ==============================================================================
# This file contains two types of configuration:
# 1. Development environment configuration (for plugin development)
# 2. API configuration (for end users)
# 
# Usage: Copy this file as `.env` and fill in the variables below as instructed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Development Environment Configuration
# ------------------------------------------------------------------------------
# These variables are used for plugin development. End users do not need to 
# configure these.

# If you are developing more than one plugin, you can store the bin path and 
# profile path in the system environment variables, which can be omitted here.

# The path of the Zotero binary file.
# The path delimiter should be escaped as `\\` for win32. 
# The path is `*/Zotero.app/Contents/MacOS/zotero` for MacOS.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /path/to/zotero.exe

# The path of the profile used for development.
# Start the profile manager by `/path/to/zotero.exe -p` to create a profile for development.
# @see https://www.zotero.org/support/kb/profile_directory
ZOTERO_PLUGIN_PROFILE_PATH = /path/to/profile

# The directory where the database is located.
# If this field is kept empty, Zotero will start with the default data.
# @see https://www.zotero.org/support/zotero_data
ZOTERO_PLUGIN_DATA_DIR =

# Custom commands to kill Zotero processes.
# Commands for different platforms are already built into zotero-plugin, 
# if the built-in commands are not suitable for your needs, please modify this variable.
# ZOTERO_PLUGIN_KILL_COMMAND = 

# GitHub Token
# For scaffold auto create release and upload assets.
# Fill in this variable if you are publishing locally instead of CI.
# GITHUB_TOKEN =

# ------------------------------------------------------------------------------
# API Configuration (End User Configuration)
# ------------------------------------------------------------------------------
# These variables are used as fallback when the plugin settings are not configured.
# Priority: Plugin Settings > Environment Variables > Default Values
# 
# End users can set these variables to avoid saving sensitive information in 
# plugin settings, or to easily switch between different API configurations.

# OpenAI API Key (Required)
# Get your API key from:
# - OpenAI: https://platform.openai.com/api-keys
# - Aliyun Qwen: https://dashscope.console.aliyun.com/apiKey
# - DeepSeek: https://platform.deepseek.com/api_keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# API Base URL (Optional)
# Default: https://api.openai.com/v1
# Examples:
# - OpenAI: https://api.openai.com/v1
# - Aliyun Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
# - DeepSeek: https://api.deepseek.com
OPENAI_BASE_URL=https://api.openai.com/v1

# Model Name (Optional)
# Default: gpt-3.5-turbo
# Examples:
# - OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# - Aliyun Qwen: qwen-max, qwen-plus, qwen-turbo, qwen3-coder-480b-a35b-instruct
# - DeepSeek: deepseek-chat, deepseek-coder
OPENAI_MODEL=gpt-3.5-turbo

# ------------------------------------------------------------------------------
# How to use these environment variables
# ------------------------------------------------------------------------------
# 
# macOS/Linux:
#   export OPENAI_API_KEY="sk-xxxxxxxxxxxx"
#   export OPENAI_BASE_URL="https://api.openai.com/v1"
#   export OPENAI_MODEL="gpt-4"
#   /Applications/Zotero.app/Contents/MacOS/zotero
#
# Windows (PowerShell):
#   $env:OPENAI_API_KEY="sk-xxxxxxxxxxxx"
#   $env:OPENAI_BASE_URL="https://api.openai.com/v1"
#   $env:OPENAI_MODEL="gpt-4"
#   Start-Process "C:\Program Files\Zotero\zotero.exe"
#
# For detailed instructions, see: doc/ENVIRONMENT_VARIABLES.md
# ------------------------------------------------------------------------------
